# voice-agents-embed — environment
#
# The embeddable voice widget. Copy to .env.local for local development.
# Every variable below is read somewhere in this repo; nothing here is aspirational.

# ---------------------------------------------------------------------------
# LiveKit
# ---------------------------------------------------------------------------

# Used by app/api/connection-details to mint the participant token. The token is
# the enforcement point for what a session may publish — the UI only reflects it.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# App configuration
# ---------------------------------------------------------------------------

# Optional remote override for the sandbox app config. Values are merged BY KEY
# into AppConfig, so anything named here can be set remotely — keep that in mind
# before adding a build constant that gates behaviour.
NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
SANDBOX_ID=

# ---------------------------------------------------------------------------
# TLZ-561 Screenshare with the web agent
# ---------------------------------------------------------------------------

# Where this app asks the dashboard whether screenshare is permitted for an
# agent, before minting the token. Resolved BEFORE the grant is built, so the
# token itself carries the screen-share source only when the dashboard says yes.
#
# Every failure path — unset, non-2xx, malformed body, timeout — resolves to
# "screenshare off" and still returns a usable audio token. A screenshare outage
# must cost the feature, never the conversation.
DASHBOARD_EMBED_CONFIG_URL=https://dashboard.telzino.io/api/embed/widget-config

# Shared secret for signing that request. Must match telzino-dashboard's
# EMBED_CONFIG_KEY_CURRENT exactly; the dashboard also accepts its
# EMBED_CONFIG_KEY_PREVIOUS, so the secret can be rotated without a coordinated
# deploy of both repos.
#
# The signature covers the body AND a unix-SECONDS timestamp, length-delimited so
# the two fields cannot be confused for one another. The dashboard allows 60
# seconds of clock skew; milliseconds here would fail every request.
#
# Unset means the widget resolves screenshare off and connects audio-only.
EMBED_CONFIG_KEY_CURRENT=

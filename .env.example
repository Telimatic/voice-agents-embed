# voice-agents-embed — environment
#
# The embeddable voice widget. Copy to .env.local for local development.
# Every variable below is read somewhere in this repo; nothing here is aspirational.

# ---------------------------------------------------------------------------
# LiveKit
# ---------------------------------------------------------------------------

# Used by app/api/connection-details to mint the participant token. The grant is
# fixed (camera + microphone); the worker widens it with SCREEN_SHARE at runtime,
# so nothing else is configured here for screenshare.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# App configuration
# ---------------------------------------------------------------------------

# Optional remote override for the sandbox app config. Values are merged BY KEY
# into AppConfig, so anything named here can be set remotely — keep that in mind
# before adding a build constant that gates behaviour.
NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
SANDBOX_ID=

# Optional override for where the browser posts to mint connection details. Falls
# back to appConfig.connectionDetailsEndpoint (for embedded usage), then to the
# relative /api/connection-details path — used by hooks/use-connection-details.ts.
NEXT_PUBLIC_CONN_DETAILS_ENDPOINT=

# ---------------------------------------------------------------------------
# Local test page (app/test/popup) — not used by the embed itself
# ---------------------------------------------------------------------------

# Agent id the test popup falls back to when no ?agentId= is in the URL. Local
# dev points at the production database, so this is not committed as a real id.
NEXT_PUBLIC_TEST_POPUP_AGENT_ID=

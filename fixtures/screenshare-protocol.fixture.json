{
  "protocolVersion": 1,
  "rpcMethods": {
    "requestConsent": "screenshare.requestConsent",
    "stop": "screenshare.stop",
    "notify": "screenshare.notify",
    "takeoverRequestViewerConsent": "takeover.requestViewerConsent",
    "displayPush": "display.push",
    "displayHighlight": "display.highlight",
    "displayClear": "display.clear",
    "displayNotify": "display.notify"
  },
  "attributes": {
    "capable": "telzino.screenshare.capable",
    "enabled": "telzino.screenshare.enabled",
    "allowedSurfaces": "telzino.screenshare.allowed_surfaces",
    "role": "telzino.role",
    "displayName": "telzino.display_name"
  },
  "attributeValues": ["true", "false"],
  "enums": {
    "shareSurface": ["browser", "window", "monitor"],
    "consentResult": ["granted", "declined", "timeout", "cancelled", "failed", "unsupported"],
    "stopReason": ["caller_stop", "browser_stop", "agent_end", "agent_left"],
    "notifyEvent": ["consent", "started", "stopped", "failed"],
    "initiatedBy": ["agent", "caller"],
    "viewerRole": ["rep", "observer"],
    "viewerConsentOutcome": ["granted", "declined", "timeout", "no_share"],
    "displayKind": ["url", "image", "pdf", "payment", "steps"],
    "displayPushError": ["not_allowlisted", "bad_payload"],
    "displayNotifyEvent": ["dismissed", "minimized", "reopened", "payment_opened"]
  },
  "examples": {
    "allowedSurfacesAttributeValue": "browser,window",
    "requestConsentPayload": {
      "v": 1,
      "scope": ["browser", "window", "monitor"],
      "viewers": [
        {
          "role": "agent"
        }
      ],
      "timeout_seconds": 30
    },
    "requestConsentResponse": {
      "v": 1,
      "result": "granted",
      "surface": "browser",
      "track_sid": "TR_AbCdEfGhIjKlMnOp"
    },
    "stopPayload": {
      "v": 1
    },
    "stopResponse": {
      "v": 1,
      "stopped": true
    },
    "notifyPayload": {
      "v": 1,
      "event": "started",
      "initiated_by": "caller",
      "result": "granted",
      "surface": "browser",
      "track_sid": "TR_AbCdEfGhIjKlMnOp"
    },
    "notifyResponse": {
      "v": 1,
      "ok": true
    },
    "viewerConsentRequest": {
      "v": 1,
      "viewer": {
        "identity": "rep-1",
        "name": "Sam",
        "role": "rep"
      }
    },
    "viewerConsentResponse": {
      "v": 1,
      "outcome": "granted"
    },
    "displayPushPayload": {
      "v": 1,
      "id": "d1",
      "kind": "payment",
      "title": "Pay invoice",
      "url": "https://pay.example.com/i/1",
      "amount_label": "$25.00"
    },
    "displayPushStepsPayload": {
      "v": 1,
      "id": "d2",
      "kind": "steps",
      "title": "Reset router",
      "steps": ["Unplug it", "Wait ten seconds", "Plug it back in"]
    },
    "displayPushResponse": {
      "v": 1,
      "ok": false,
      "error": "not_allowlisted"
    },
    "displayHighlightPayload": {
      "v": 1,
      "id": "d1",
      "step": 2
    },
    "displayHighlightResponse": {
      "v": 1,
      "ok": true
    },
    "displayClearPayload": {
      "v": 1
    },
    "displayNotifyPayload": {
      "v": 1,
      "event": "dismissed",
      "id": "d1"
    },
    "displayHighlightRegionPayload": {
      "v": 1,
      "id": "d1",
      "region": {
        "x": 0.1,
        "y": 0.2,
        "w": 0.5,
        "h": 0.25
      }
    },
    "displayPushResponseNullError": {
      "v": 1,
      "ok": true,
      "error": null
    }
  },
  "constants": {
    "photoTopic": "telzino.photo",
